{
  "name": "yandex-med-feed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "FEED=a vite",
    "dev:a": "FEED=a vite",
    "dev:b": "FEED=b vite",
    "dev:prototype": "vite",
    "build": "tsc -b && npm run build:a && npm run build:b && node scripts/inline-assets.mjs && node scripts/build-landing.mjs",
    "build:a": "FEED=a vite build",
    "build:b": "FEED=b vite build",
    "build:prototype": "vite build",
    "preview": "vite preview --outDir dist --port 4173",
    "typecheck": "tsc -b --noEmit",
    "build:pages": "npm run build && rm -rf docs && cp -R dist docs && touch docs/.nojekyll"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
