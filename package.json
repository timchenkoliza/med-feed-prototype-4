{
  "name": "yandex-med-feed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inline-assets.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "build:pages": "npm run build && rm -rf docs && cp -R dist docs && touch docs/.nojekyll",
    "sources:import": "node scripts/import-sources.mjs",
    "news:ingest": "node scripts/ingest-news.mjs",
    "data:refresh": "npm run sources:import && npm run news:ingest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
